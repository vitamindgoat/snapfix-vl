# Copy to `.env` before `malexai run`.

# Generate tenant API key at https://malex.ai/dashboard/security (Dashboard → Security → Malex API key)
MALEX_API_KEY=

# GPU instance type for `malexai run` (canonical id from Edge gpu_types catalog)
# Examples: l40s (default), a100_sxm4_80gb, a100_80gb_pcie, rtx_4090
MALEX_BOOTSTRAP_GPU_NAME=a100_sxm4_80gb

# Tenant app secrets (local only — synced to Edge KV at deploy)
HF_TOKEN=
GOOGLE_PLACES_API_KEY=

# Vision model — Transformers in-process (Procfile sets SNAPFIX_VISION_DEVICE=cuda on GPU).
# Local Mac (8–16 GB): use 2B + MPS; keep rerank on CPU to avoid MPS contention.
SNAPFIX_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
SNAPFIX_VISION_DEVICE=mps
SNAPFIX_RERANK_DEVICE=cpu
